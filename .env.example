# Copy to .env and fill in. Never commit .env (it is gitignored).

# MongoDB Atlas connection string for a user with readWrite on socially_db only.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/socially_db

# Signs user sessions. 64+ random hex chars. Changing it logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=

# Admin panel password (also signs 8-hour admin sessions). 32+ random chars.
SUPER_ADMIN_SECRET=

# Web push keys:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

NODE_ENV=production
PORT=5000

# Optional
# CORS_ORIGINS=https://staging.example.com      extra allowed web origins, comma-separated
# TRUST_PROXY=1                                 hops of reverse proxy in front of the server
# GOOGLE_CLIENT_IDS=...                         Google OAuth client ids (comma-separated)
# AUDIT_LOG_VERBOSE=false                       log every successful request
# IMAGE_URL_REWRITE=true                        serve base64 images as /img URLs
# ALLOW_LEGACY_AUTH=false                       NEVER enable in production
